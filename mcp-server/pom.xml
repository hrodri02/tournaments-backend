<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  Deliberately NOT a module of the root pom. This is a separate deployable: it
	  builds, versions and runs on its own, and `./mvnw test` at the root keeps
	  meaning "test the backend". Build it with:

	      ./mvnw -f mcp-server/pom.xml package
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.example</groupId>
	<artifactId>tournaments-mcp-server</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>tournaments-mcp-server</name>
	<description>MCP server for the tournaments API, running in its own process</description>

	<properties>
		<java.version>23</java.version>
		<mcp-sdk.version>2.0.0</mcp-sdk.version>
	</properties>

	<dependencies>
		<!--
		  Web, but no data-jpa and no postgresql driver: this process reaches
		  tournament data only through the backend's REST API, and holds no
		  database credentials. That is the whole point of this variant.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!--
		  Spring Boot 4 no longer ships RestClient's autoconfiguration with
		  starter-web; without this there is no RestClient.Builder bean and no
		  spring.http.client.* timeout support.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>
		<!--
		  The MCP protocol itself, from the official SDK, with no Spring AI in
		  between. `mcp` is an aggregator over two jars: `mcp-core`, which holds
		  the servlet transport, the server and the schema types, and
		  `mcp-json-jackson3`, which supplies the JSON mapper and the schema
		  validator the server uses to check tool arguments.

		  Spring AI's starter wraps exactly these. What it added on top was
		  @McpTool scanning, input schemas generated from method signatures, and
		  exceptions turned into error results; that is what `tools/ToolCatalog`
		  and `tools/ToolResults` now do by hand.
		-->
		<dependency>
			<groupId>io.modelcontextprotocol.sdk</groupId>
			<artifactId>mcp</artifactId>
			<version>${mcp-sdk.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--
			  The Spring AI variant pinned -parameters here explicitly. The Boot
			  parent sets it either way, so the flag is still on; what changed is
			  that it no longer matters to the protocol. There, the tool schema
			  was reflected out of the method, and losing parameter names would
			  have advertised `get_league`'s argument to the model as "arg0".
			  Here the argument names are written in the schemas in ToolCatalog,
			  so nothing a compiler flag controls can change what a client sees.
			-->
		</plugins>
	</build>
</project>
